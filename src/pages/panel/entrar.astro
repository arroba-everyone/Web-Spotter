---
/**
 * Entrar al panel.
 *
 * Dos formas: la cuenta de Google del equipo, o correo y contraseña. Sin
 * registro: las cuentas se crean a mano desde Supabase, una por persona.
 *
 * El documento descartaba Google (§6.1), pero las cuentas del equipo son de
 * Google y así no hay ninguna contraseña que repartir. Entrar por un sitio o
 * por otro da igual: quien decide es `app_metadata.staff` del token.
 */
import PanelLayout from '../../layouts/PanelLayout.astro';
---

<PanelLayout title="Entrar" conMenu={false}>
  <div class="entrar">
    <h1 class="panelTitulo">Panel de Spotter</h1>
    <p class="panelSubtitulo">Acceso interno. Las cuentas las crea el equipo.</p>

    <p class="panelAviso panelAviso--error" data-sin-acceso hidden>
      Esta cuenta no tiene acceso al panel.
    </p>

    <button type="button" class="panelBoton google" data-google>
      <svg viewBox="0 0 18 18" aria-hidden="true" width="18" height="18">
        <path
          fill="#4285f4"
          d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"
        ></path>
        <path
          fill="#34a853"
          d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.92v2.33A9 9 0 0 0 9 18Z"
        ></path>
        <path
          fill="#fbbc05"
          d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.92a9 9 0 0 0 0 8.1l3.05-2.33Z"
        ></path>
        <path
          fill="#ea4335"
          d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .92 4.95l3.05 2.33C4.68 5.16 6.66 3.58 9 3.58Z"
        ></path>
      </svg>
      Entrar con Google
    </button>

    <p class="separador">o con correo y contraseña</p>

    <form class="panelFormulario" data-formulario-entrar>
      <div class="panelCampo">
        <label for="correo">Correo</label>
        <input id="correo" name="correo" type="email" autocomplete="username" required />
      </div>

      <div class="panelCampo">
        <label for="contrasena">Contraseña</label>
        <input
          id="contrasena"
          name="contrasena"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>

      <p class="panelAviso panelAviso--error" data-error hidden></p>

      <button type="submit" class="panelBoton panelBoton--principal" data-enviar>Entrar</button>

      <button type="button" class="panelBoton panelBoton--discreto" data-olvidada>
        He olvidado la contraseña
      </button>

      <p class="panelAviso" data-correo-enviado hidden>
        Si esa cuenta existe, le llega un correo para cambiar la contraseña.
      </p>
    </form>
  </div>
</PanelLayout>

<style>
  .entrar {
    display: grid;
    gap: var(--space4);
    max-width: 380px;
    margin-inline: auto;
    padding-block: var(--space20);
  }

  .google {
    min-height: var(--buttonHeight);
    font-size: var(--fontSizeBody);
  }

  /* Una raya a cada lado del texto, para separar las dos formas de entrar. */
  .separador {
    display: flex;
    align-items: center;
    gap: var(--space3);
    font-size: var(--fontSizeCaption);
    color: var(--colorTextTertiary);
  }

  .separador::before,
  .separador::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--colorSeparator);
  }
</style>

<script>
  import {
    clienteSpotter,
    entrarConGoogle,
    mensajeDeError,
    sesionActual,
    RUTA_INICIO,
  } from '../../scripts/panel/cliente';

  const formulario = document.querySelector<HTMLFormElement>('[data-formulario-entrar]');
  const error = document.querySelector<HTMLElement>('[data-error]');
  const enviar = document.querySelector<HTMLButtonElement>('[data-enviar]');
  const correoEnviado = document.querySelector<HTMLElement>('[data-correo-enviado]');

  // Aviso para quien ha entrado con una cuenta que no es del equipo.
  if (new URLSearchParams(window.location.search).has('sinAcceso')) {
    document.querySelector<HTMLElement>('[data-sin-acceso]')?.removeAttribute('hidden');
  }

  /**
   * Comprueba la sesión y decide a dónde va.
   *
   * Se llama dos veces: al cargar (por si ya había sesión) y cuando Google
   * devuelve al navegador, porque el cambio del código por la sesión tarda un
   * momento y para entonces la primera comprobación ya ha pasado.
   */
  async function llevarDondeToque(): Promise<void> {
    const sesion = await sesionActual();
    if (!sesion) return;

    if (sesion.esStaff) {
      window.location.replace(RUTA_INICIO);
      return;
    }

    // Tiene cuenta, pero no es del equipo: fuera, y explicado.
    await clienteSpotter().auth.signOut();
    mostrarError('Esta cuenta no tiene acceso al panel.');
  }

  clienteSpotter().auth.onAuthStateChange((evento) => {
    if (evento === 'SIGNED_IN') void llevarDondeToque();
  });

  await llevarDondeToque();

  function mostrarError(texto: string | null): void {
    if (!error) return;
    error.textContent = texto ?? '';
    error.hidden = texto === null;
  }

  function campos(): { correo: string; contrasena: string } {
    const datos = new FormData(formulario!);
    return {
      correo: String(datos.get('correo') ?? '').trim(),
      contrasena: String(datos.get('contrasena') ?? ''),
    };
  }

  formulario?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    mostrarError(null);
    if (enviar) enviar.disabled = true;

    const { correo, contrasena } = campos();
    const { data, error: fallo } = await clienteSpotter().auth.signInWithPassword({
      email: correo,
      password: contrasena,
    });

    if (fallo || !data.user) {
      mostrarError(mensajeDeError(fallo));
      if (enviar) enviar.disabled = false;
      return;
    }

    // Quien no es del equipo no pasa de aquí, y se le cierra la sesión.
    if (data.user.app_metadata?.['staff'] !== true) {
      await clienteSpotter().auth.signOut();
      mostrarError('Esta cuenta no tiene acceso al panel.');
      if (enviar) enviar.disabled = false;
      return;
    }

    window.location.replace(RUTA_INICIO);
  });

  document.querySelector<HTMLButtonElement>('[data-google]')?.addEventListener('click', async () => {
    mostrarError(null);
    const { error: fallo } = await entrarConGoogle();
    // Si sale bien, el navegador ya se ha ido a Google y esto no se llega a ver.
    if (fallo) mostrarError(fallo);
  });

  document.querySelector<HTMLButtonElement>('[data-olvidada]')?.addEventListener('click', async () => {
    const { correo } = campos();
    if (correo === '') {
      mostrarError('Escribe primero tu correo.');
      return;
    }

    mostrarError(null);
    await clienteSpotter().auth.resetPasswordForEmail(correo, {
      redirectTo: `${window.location.origin}/panel/entrar/`,
    });
    // Siempre el mismo mensaje: decir si el correo existe delataría cuentas.
    correoEnviado?.removeAttribute('hidden');
  });
</script>
