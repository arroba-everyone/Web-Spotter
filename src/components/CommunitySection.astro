---
/**
 * Comunidad: los grupos dentro de la app y los encuentros fuera de ella.
 *
 * Los tipos de grupo flotan alrededor del teléfono como píldoras de cristal: son
 * etiquetas, no contenido, así que el cristal está bien usado (brief, §6).
 *
 * Los afterworks están sacados del Instagram de la marca, donde se anuncian. Se
 * cuentan como algo que organiza el equipo, no como una función de la app:
 * las quedadas dentro de la app no se pueden prometer todavía (brief, §3).
 */
import Button from './Button.astro';
import PhoneFrame from './PhoneFrame.astro';
import SectionHeading from './SectionHeading.astro';
import { captures } from '../domain/captures';
import { links } from '../domain/links';
import { useTranslations, type Locale } from '../i18n';

const t = useTranslations(Astro.currentLocale as Locale);
---

<section class="community" id="comunidad">
  <div class="community__inner pageContainer">
    <div class="community__visual">
      <PhoneFrame image={captures.messages} alt={t.community.captureAlt} width="min(70vw, 300px)" />
      {
        t.community.groupKinds.map((kind, index) => (
          <span class="community__chip glass" style={`--chipOrder: ${index}`}>
            {kind}
          </span>
        ))
      }
    </div>

    <div class="community__text">
      <SectionHeading eyebrow={t.community.eyebrow} title={t.community.title} lead={t.community.body} />

      <blockquote class="community__quote reveal">{t.community.quote}</blockquote>

      <div class="community__events reveal">
        <h3 class="community__eventsTitle">{t.community.eventsTitle}</h3>
        <p class="community__eventsBody">{t.community.eventsBody}</p>
        <Button variant="glass" href={links.instagram} external>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="0.6" />
          </svg>
          {/* Una sola cadena: al comprimir el HTML, Astro se come el espacio entre dos llaves seguidas. */}
          {`${t.community.eventsAction} ${links.instagramHandle}`}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .community {
    padding-block: var(--sectionPadding);
    overflow: hidden;
  }

  .community__inner {
    display: grid;
    gap: var(--space16);
    align-items: center;
  }

  .community__visual {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: var(--space8);
  }

  /* Halo morado detrás: pone color detrás del cristal de las píldoras. */
  .community__visual::before {
    content: '';
    position: absolute;
    inset: 10% 5%;
    background: radial-gradient(circle, var(--colorSportCalisthenics) 0%, transparent 65%);
    opacity: 0.22;
    filter: blur(30px);
  }

  .community__chip {
    position: absolute;
    padding: var(--space2) var(--space4);
    border-radius: var(--radiusPill);
    font-size: var(--fontSizeCaption);
    font-weight: var(--fontWeightSemibold);
    white-space: nowrap;
  }

  .community__chip:nth-of-type(1) {
    top: 14%;
    left: 0;
  }

  .community__chip:nth-of-type(2) {
    top: 46%;
    right: 0;
  }

  .community__chip:nth-of-type(3) {
    bottom: 12%;
    left: 6%;
  }

  /* Flotan despacio, cada una a su ritmo, como las burbujas. */
  @media (prefers-reduced-motion: no-preference) {
    .community__chip {
      animation: chipFloats 5s ease-in-out infinite alternate;
      animation-delay: calc(var(--chipOrder) * -1.7s);
    }
  }

  @keyframes chipFloats {
    to {
      translate: 0 -14px;
    }
  }

  .community__quote {
    margin: var(--space12) 0 0;
    padding-left: var(--space6);
    border-left: 3px solid var(--colorBrand);
    font-size: var(--fontSizeTitle3);
    font-weight: var(--fontWeightBold);
    line-height: var(--lineHeightSnug);
    text-wrap: balance;
  }

  .community__events {
    display: grid;
    justify-items: start;
    gap: var(--space3);
    margin-top: var(--space12);
  }

  .community__eventsTitle {
    font-size: var(--fontSizeHeadline);
    font-weight: var(--fontWeightSemibold);
  }

  .community__eventsBody {
    max-width: 44ch;
    margin-bottom: var(--space3);
    color: var(--colorTextSecondary);
  }

  .community__events svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  @media (min-width: 900px) {
    .community__inner {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space20);
    }
  }
</style>
