---
/**
 * La frase que resume el producto, iluminándose palabra a palabra con el scroll.
 *
 * No hay JavaScript: cada palabra tiene su propio tramo de la sección y se
 * enciende cuando el scroll pasa por él. Para que dé tiempo a leerla, la sección
 * mide más de una pantalla y la frase se queda fija en el centro mientras tanto.
 *
 * Todo eso solo ocurre si el navegador entiende las animaciones ligadas al
 * scroll y nadie ha pedido menos movimiento. Si no, la frase se ve entera y
 * encendida desde el principio, en una sección de altura normal.
 */
import { useTranslations, type Locale } from '../i18n';

const t = useTranslations(Astro.currentLocale as Locale);

const words = t.manifesto.text.split(' ');
/** Parte del recorrido en la que se encienden las palabras. El resto es pausa para leerla entera. */
const lightingShare = 80;
// Las dos últimas palabras («de compañía» / «of company») van en rojo: son la idea.
const highlightFrom = words.length - 2;

const segments = words.map((word, index) => ({
  word,
  start: `${((index / words.length) * lightingShare).toFixed(2)}%`,
  end: `${(((index + 1) / words.length) * lightingShare).toFixed(2)}%`,
  highlight: index >= highlightFrom,
}));
---

<section class="manifesto">
  <div class="manifesto__sticky">
    <div class="pageContainer">
    <p class="manifesto__text">
      {
        segments.map((segment) => (
          <span
            class:list={['manifesto__word', { 'is-highlight': segment.highlight }]}
            style={`--start: ${segment.start}; --end: ${segment.end}`}
          >
            {segment.word}{' '}
          </span>
        ))
      }
    </p>
    </div>
  </div>
</section>

<style>
  .manifesto {
    padding-block: var(--sectionPadding);
    view-timeline-name: --manifesto;
  }

  .manifesto__text {
    max-width: 17ch;
    font-size: var(--fontSizeDisplay);
    font-weight: var(--fontWeightBlack);
    line-height: var(--lineHeightSnug);
    letter-spacing: var(--letterSpacingDisplay);
    text-wrap: balance;
  }

  .manifesto__word.is-highlight {
    color: var(--colorBrand);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Más alta que la pantalla: el sobrante es el recorrido de la animación. */
      .manifesto {
        height: 260svh;
        padding-block: 0;
      }

      .manifesto__sticky {
        position: sticky;
        top: 0;
        display: grid;
        align-items: center;
        height: 100svh;
      }

      .manifesto__word {
        animation: wordLightsUp linear both;
        animation-timeline: --manifesto;
        /* «contain» es el tramo en el que la sección cubre la pantalla entera. */
        animation-range: contain var(--start) contain var(--end);
      }

      .manifesto__word.is-highlight {
        animation-name: wordLightsUpRed;
      }
    }
  }

  @keyframes wordLightsUp {
    from {
      color: rgb(235 235 245 / 14%);
    }
    to {
      color: var(--colorTextPrimary);
    }
  }

  @keyframes wordLightsUpRed {
    from {
      color: rgb(235 235 245 / 14%);
    }
    to {
      color: var(--colorBrand);
    }
  }
</style>
